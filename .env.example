# Copy this file to .env.local and restart the development server.
# Keep the real key in .env.local only; never use NEXT_PUBLIC_ for API secrets.
# The key is read only by /api/incidents/assess on the server.
OPENAI_API_KEY=

# Default documented Responses model. Override with a model available to your
# OpenAI API project that supports Responses + strict structured JSON output.
OPENAI_MODEL=gpt-6-astra

# Without a key (or on API timeout/error), the demo stays usable and explicitly
# labels judge reports as offline catalog matches or requiring operator review.
# The catalog, production line and all numerical planning data are synthetic.
